# Local Docker infrastructure (copy to .env and replace every placeholder).
POSTGRES_DB=agrospace
POSTGRES_USER=agrospace
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
POSTGRES_PORT=55432
# Host used by Django running on the host machine. Use `postgres` only when
# Django itself runs inside the Compose network.
POSTGRES_HOST=127.0.0.1

REDIS_PASSWORD=replace-with-a-unique-local-development-password
REDIS_PORT=6379
REDIS_HOST=127.0.0.1

# Celery (Phase 1D) — reuses the Redis service above. DB indexes are optional;
# full broker/result URLs may instead be supplied via CELERY_BROKER_URL /
# CELERY_RESULT_BACKEND (e.g. redis://redis:6379/0 for an in-Compose worker).
CELERY_BROKER_DB=0
CELERY_RESULT_DB=1

# Django backend (Phase 1B)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dockerized Django backend (Phase 2 Step 0)
# Host port for the backend container (published on 127.0.0.1 only).
BACKEND_PORT=8000
# The Compose `backend` service overrides POSTGRES_HOST=postgres,
# POSTGRES_PORT=5432 and REDIS_HOST=redis. The values above are for host tools.
#
# GeoDjango native libraries are installed inside the backend image, so no path
# overrides are needed. Uncomment only for a non-standard install:
# GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# Frontend (Phase 1C) — copy frontend/.env.example to frontend/.env
# Only public values belong in Vite env files. Never put secrets here.
# VITE_API_BASE_URL=http://127.0.0.1:8000
