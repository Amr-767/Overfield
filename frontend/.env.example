# Public browser-safe config only.
# Never put Django secrets, database passwords, or NASA credentials here.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Map tile source. OpenStreetMap is the prototype default and requires visible
# attribution. Follow the OSM tile usage policy (no bulk downloads).
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
